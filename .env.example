# NVIDIA NIM Configuration
NVIDIA_NIM_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=stepfun-ai/step-5-preview

# Expo Client Configuration
# Do not put an API key in an EXPO_PUBLIC_ variable; enter it in the app's Settings tab.
EXPO_PUBLIC_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
EXPO_PUBLIC_NVIDIA_NIM_MODEL=stepfun-ai/step-5-preview
EXPO_PUBLIC_DOMAIN=

PORT=5000
